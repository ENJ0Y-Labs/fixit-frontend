# Public browser configuration for the FixIt provider app.
# Local placeholder for the proposed API; no backend is currently deployed.
# VITE_* values are bundled into browser code. Never put secrets here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Absolute URL of the separately deployed customer app, e.g. https://fixit.example.com/
VITE_CUSTOMER_APP_URL=/
