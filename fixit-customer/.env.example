# Public browser configuration. VITE_* values are bundled into client code.
# Replace this local placeholder when the FixIt backend is deployed.
# Never put secrets, passwords, signing keys, or payment credentials here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Absolute URL of the separately deployed provider app, e.g. https://providers.example.com/
VITE_PROVIDER_APP_URL=/provider/
